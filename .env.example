# Environment variables — names only, NEVER commit actual values here.
# Copy this to .env and fill in values locally or set in Lambda environment.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=

# ── DynamoDB ─────────────────────────────────────────────────────────────────
DYNAMODB_DOCUMENTS_TABLE=
DYNAMODB_CLAIMS_TABLE=

# ── Crossref (polite pool — include your contact email) ───────────────────────
CROSSREF_CONTACT_EMAIL=
CROSSREF_BASE_URL=https://api.crossref.org

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
