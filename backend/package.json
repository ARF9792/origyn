{
  "name": "origyn-backend",
  "version": "0.1.0",
  "description": "Origyn backend — AWS Lambda / API Gateway / S3 / DynamoDB / Bedrock",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "build:js": "tsc",
    "test": "npx --no jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sts": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "busboy": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.143",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
